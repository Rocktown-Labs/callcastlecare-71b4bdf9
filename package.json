{
  "name": "callcastlecare",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "tsx": "^4.22.5",
      "better-auth": "1.6.23",
      "evlog": "^2.22.0",
      "lucide-react": "^1.23.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.2",
      "@tanstack/react-form": "^1.33.0",
      "@types/react-dom": "^19.2.3",
      "tailwind-merge": "^3.6.0",
      "@better-auth/expo": "1.6.23"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native",
    "dev:web": "turbo run dev -F web",
    "dev:server": "turbo run dev -F server",
    "db:push": "turbo run db:push -F @callcastlecare/db",
    "db:studio": "turbo run db:studio -F @callcastlecare/db",
    "db:generate": "turbo run db:generate -F @callcastlecare/db",
    "db:migrate": "turbo run db:migrate -F @callcastlecare/db",
    "db:reset": "turbo run db:reset -F @callcastlecare/db",
    "deploy:setup": "vercel link",
    "dev:vercel": "vercel dev -L",
    "env:preview": "tsx scripts/sync-vercel-env.ts preview",
    "env:production": "tsx scripts/sync-vercel-env.ts production",
    "deploy": "vercel deploy",
    "deploy:prod": "vercel deploy --prod",
    "deploy:check": "vercel deploy --dry",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@callcastlecare/env": "workspace:*",
    "dotenv": "catalog:",
    "marketingskills": "coreyhaines31/marketingskills",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@callcastlecare/config": "workspace:*",
    "@types/node": "^22.13.14",
    "lefthook": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "tsx": "catalog:",
    "turbo": "^2.10.2",
    "typescript": "^6",
    "ultracite": "7.9.3",
    "vercel": "^57.0.0"
  },
  "packageManager": "bun@1.3.14"
}
