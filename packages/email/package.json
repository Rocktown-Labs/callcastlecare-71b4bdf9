{
  "name": "@callcastlecare/email",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./templates/*": "./src/templates/*.tsx"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "email": "email dev --dir src/templates --port 3001",
