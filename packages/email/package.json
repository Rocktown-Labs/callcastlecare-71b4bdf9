    "test": "vitest run"
  },
  "dependencies": {
    "@react-email/components": "^1.0.1",
    "@react-email/render": "^2.0.1",
    "react": "^19.2.7",
    "react-email": "^4.3.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@callcastlecare/config": "workspace:*",
    "@react-email/preview-server": "4.3.2",
    "@types/react": "^19.2.17",
    "typescript": "^6",
    "vitest": "^4.1.10"
  }
}
