# Required
DATABASE_URL=postgres://user:password@host:5432/callcastlecare
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3001/api/auth
CORS_ORIGIN=http://localhost:3000

# Integrations
RADAR_API_KEY=
RENTCAST_API_KEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
VERCEL_BLOB_READ_WRITE_TOKEN=

# Stripe: keep test and live values in separate deployment environments.
# Prefer a restricted key (rk_test_ / rk_live_) with only required permissions.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_BASE_URL=http://localhost:3001
STRIPE_BILLING_WEBHOOK_SECRET=
STRIPE_COMMERCE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Legacy single-endpoint compatibility; new sync uses the three secrets above.
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_PUBLIC_URL=

# Marketplace settlement policy. Keep provider payout at 6000 (60%) unless approved.
PLATFORM_FEE_BPS=0
PROVIDER_PAYOUT_BPS=6000
ADMIN_EMAIL=cg@rocktownlabs.com
NODE_ENV=development
